# Rendered by the nginx image's template mechanism at container start.
# Only ${NGINX_*} variables are substituted (NGINX_ENVSUBST_FILTER); nginx's own $vars are untouched.
limit_req_zone $binary_remote_addr zone=api:10m rate=${NGINX_RATE_LIMIT}r/s;
limit_req_status 429;  # same status as the per-user throttles in Django

upstream django {
    server web:8000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 1m;
    gzip on;
    gzip_types application/json text/plain text/css application/javascript;

    location /static/ {
        alias /app/staticfiles/;
        expires 7d;
        access_log off;
    }

    location / {
        limit_req zone=api burst=${NGINX_RATE_BURST} nodelay;

        proxy_pass http://django;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 65s;
        proxy_connect_timeout 5s;
    }
}
