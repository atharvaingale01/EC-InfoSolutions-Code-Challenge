# Rendered by the nginx image's template mechanism at container start.
# Only ${NGINX_*} variables are substituted (NGINX_ENVSUBST_FILTER); nginx's own $vars are untouched.
limit_req_zone $binary_remote_addr zone=api:10m rate=${NGINX_RATE_LIMIT}r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=1r/s;  # admin login brute-force guard
limit_req_status 429;  # same status as the per-user throttles in Django

log_format correlated '$remote_addr [$time_local] "$request" $status $body_bytes_sent rid=$request_id rt=$request_time';
access_log /var/log/nginx/access.log correlated;

upstream django {
    server web:8000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 1m;
    gzip on;
    gzip_types application/json text/plain text/css application/javascript;

    location /static/ {
        alias /app/staticfiles/;
        expires 7d;
        access_log off;
    }

    # Django REST Framework throttles /auth/token/ itself; the admin login form
    # has no application-level limit, so nginx applies a strict one here.
    location = /admin/login/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://django;
        include /etc/nginx/proxy_headers.conf;
    }

    location / {
        limit_req zone=api burst=${NGINX_RATE_BURST} nodelay;
        proxy_pass http://django;
        include /etc/nginx/proxy_headers.conf;
    }
}
