# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Allow browser clients from any origin (set 0 and configure CORS_ALLOWED_ORIGINS for production)
CORS_ALLOW_ALL_ORIGINS=1

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=musicdb
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
CACHE_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Spotify (https://developer.spotify.com/dashboard) --------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
SPOTIFY_CACHE_TTL_SECONDS=21600
SPOTIFY_USE_RECOMMENDATIONS_ENDPOINT=0
# 1 = serve fixture tracks instead of calling Spotify (no credentials needed).
# Use when the Spotify app owner has no Premium subscription (Web API blocked).
SPOTIFY_MOCK=0

# --- Recommendations ------------------------------------------------------
RECS_CACHE_TTL_SECONDS=3600
RECS_REFRESH_INTERVAL_MINUTES=360
RECS_DEFAULT_LIMIT=20

# --- Auth / throttling ----------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
THROTTLE_ANON=20/min
THROTTLE_USER=120/min
THROTTLE_REFRESH=5/min
THROTTLE_ACTIVITY=60/min

# --- nginx (base stack) ---------------------------------------------------
NGINX_PORT=80
# Edge rate limit per client IP, applied before requests reach Django:
# NGINX_RATE_LIMIT = requests per second, NGINX_RATE_BURST = burst allowance
NGINX_RATE_LIMIT=30
NGINX_RATE_BURST=50

# --- dev stack host ports (docker-compose.dev.yml) -------------------------
DEV_WEB_PORT=8000
DEV_DB_PORT=5432
DEV_REDIS_PORT=6379
