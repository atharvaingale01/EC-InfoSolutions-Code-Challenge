            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/activity/",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"track_id\": \"6WlARP6h4CDVOcY386wW0W\",\n  \"track_name\": \"Sitaare (From \\\"Ikkis\\\")\",\n  \"artist_name\": \"Arijit Singh\",\n  \"action\": \"play\"\n}"
            }
