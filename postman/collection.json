                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/activity/",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"track_id\": \"7tbzfR8ZvZzJEzy6v0d6el\",\n  \"track_name\": \"Liggi\",\n  \"artist_name\": \"Ritviz\",\n  \"action\": \"skip\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/analytics/summary/",
            "description": ""
          },
          "response": []
        },
        {
          "name": "Trends",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/analytics/trends/?days=7&limit=10",
            "description": ""
          },
          "response": []
        },
        {
          "name": "User summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/analytics/user/{{user_id}}/",
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Basic Auth (alternative)",
      "description": "Same endpoints authenticated with HTTP Basic using {{email}} / {{password}}.",
      "item": [
        {
          "name": "Get user profile (Basic)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/{{user_id}}/",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get recommendations (Basic)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/recommendations/{{user_id}}/",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Summary (Basic)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/analytics/summary/",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "string"
                },
                {
