{
  "info": {
    "name": "Music Discovery API",
    "description": "Spotify-backed recommendations, activity tracking and analytics.\n\n**Flow:** run `Auth \u2192 Login` first (sets `access_token`, `refresh_token`, `user_id`). All other requests inherit Bearer auth from the collection. The `Basic Auth` folder shows the same endpoints using HTTP Basic instead.\n\nSeed demo users with `make seed` (password `Password123!`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (anonymous POST /users/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/users/",
            "description": "No token \u2192 registers. Same route with a token updates your own profile.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"New User\",\n  \"favorite_genres\": [\n    \"bollywood\",\n    \"indian pop\"\n  ],\n  \"favorite_artists\": [\n    \"Arijit Singh\"\n  ],\n  \"moods\": [\n    \"romantic\"\n  ]\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const b = pm.response.json();",
                  "if (b.id) pm.environment.set('user_id', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (obtain JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/token/",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.environment.set('access_token', b.access);",
                  "pm.environment.set('refresh_token', b.refresh);",
                  "// user id lives in the JWT payload (claim `user_id`)",
                  "const payload = JSON.parse(atob(b.access.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.environment.set('user_id', payload.user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/token/refresh/",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('access_token', pm.response.json().access);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Update my profile (authenticated POST /users/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/users/",
            "description": "Partial update of the caller's own profile. Triggers a recommendation refresh.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Updated\",\n  \"favorite_genres\": [\n    \"punjabi\",\n    \"bhangra\"\n  ],\n  \"moods\": [\n    \"party\",\n    \"energetic\"\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('user_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/{{user_id}}/",
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Trigger refresh (async)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/recommendations/{{user_id}}/refresh/",
            "description": "Returns 202 with a task id. Throttled to 5/min per user."
          },
          "response": []
        },
        {
          "name": "Get recommendations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/recommendations/{{user_id}}/?limit=20",
            "description": "200 with tracks, 202 while pending, 404 if never generated."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Activity",
      "item": [
        {
          "name": "Record play",
          "request": {
